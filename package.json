{
  "name": "rh-workflow-desk",
  "version": "0.3.2",
  "private": true,
  "author": "LLsetnow",
  "description": "RH Workflow Desk 的 Windows 和 macOS 桌面版",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "start:web": "./scripts/start.sh",
    "electron": "electron .",
    "package:mac": "./scripts/build-macos.sh",
    "package:win": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-windows.ps1"
  },
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "cn.runninghub.rhworkflowdesk",
    "productName": "RH Workflow Desk",
    "asar": true,
    "files": [
      "electron/**/*",
      "static/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "artifactName": "RH-Workflow-Desk-${version}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "static/assets/rh-workflow-desk.icns",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "build/macos/rh-workflow-desk-server",
          "to": "rh-workflow-desk-server"
        }
      ]
    },
    "win": {
      "icon": "static/assets/rh-workflow-desk.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "build/windows/rh-workflow-desk-server.exe",
          "to": "rh-workflow-desk-server.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "RH Workflow Desk"
    }
  }
}
